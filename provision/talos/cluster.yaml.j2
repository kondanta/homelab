---
# STAGED DRAFT — targets Talos 1.14 multi-document config format
# Verify all document kinds and field names against the 1.14 stable release notes before applying.
# Apply AFTER the node rename operation (see provision/talos/memory/2026-08-01_node-rename-playbook.md).
#
# This file replaces machineconfig.yaml.j2 (keep the old file until node rename + 1.14 migration are applied).
#
# What remains in v1alpha1: CA crt (public), machine token, cluster identity, cluster endpoint.
# The shim requires these stay in v1alpha1 — see grilling session notes for rationale.
version: v1alpha1
machine:
  ca:
    crt: {{ MACHINE_CA_CRT }}
  features:
    apidCheckExtKeyUsage: true
    diskQuotaSupport: true
    rbac: true
  token: {{ MACHINE_TOKEN }}
cluster:
  ca:
    crt: {{ CLUSTER_CA_CRT }}
  clusterName: homelab
  controlPlane:
    endpoint: https://10.1.20.11:6443
  discovery:
    enabled: true
    registries:
      kubernetes:
        disabled: true
      service: {}
  id: {{ CLUSTER_ID }}
  secret: {{ CLUSTER_SECRET }}
  token: {{ CLUSTER_TOKEN }}
---
# VERIFY: UnattendedInstallConfig — disk selector uses CEL (disk.model), not YAML struct
apiVersion: v1alpha1
kind: UnattendedInstallConfig
image: factory.talos.dev/metal-installer/89c7d76eb7d8a185c8e80f7e5b6d3c78d8bc31f4f27c12fde293e13f5c4e035f:v1.13.7
diskSelector:
  match: disk.model == "512GB SSD"
wipe: false
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: nvme_tcp
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: vfio_pci
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: uio_pci_generic
---
apiVersion: v1alpha1
kind: SysctlConfig
sysctls:
  fs.inotify.max_user_instances: "8192"
  fs.inotify.max_user_watches: "1048576"
  net.core.default_qdisc: fq
  net.core.rmem_max: "67108864"
  net.core.wmem_max: "67108864"
  net.ipv4.neigh.default.gc_thresh1: "4096"
  net.ipv4.neigh.default.gc_thresh2: "8192"
  net.ipv4.neigh.default.gc_thresh3: "16384"
  net.ipv4.tcp_congestion_control: bbr
  net.ipv4.tcp_fastopen: "3"
  net.ipv4.tcp_mtu_probing: "1"
  net.ipv4.tcp_rmem: 4096 87380 33554432
  net.ipv4.tcp_window_scaling: "1"
  net.ipv4.tcp_wmem: 4096 65536 33554432
  sunrpc.tcp_max_slot_table_entries: "128"
  sunrpc.tcp_slot_table_entries: "128"
  user.max_user_namespaces: "11255"
  vm.nr_hugepages: "1024"
---
# VERIFY: EtcFileConfig schema — confirm 'files' array key and op/permissions fields
apiVersion: v1alpha1
kind: EtcFileConfig
files:
  - op: overwrite
    path: /etc/nfsmount.conf
    permissions: 0o644
    content: |
      [ NFSMount_Global_Options ]
      nfsvers=4.2
      hard=True
      nconnect=16
      noatime=True
      rsize=1048576
      wsize=1048576
---
# VERIFY: CRICustomizationConfig schema — confirm 'config' field takes raw TOML
apiVersion: v1alpha1
kind: CRICustomizationConfig
config: |
  [plugins."io.containerd.cri.v1.images"]
    discard_unpacked_layers = false
  [plugins."io.containerd.cri.v1.runtime"]
    cdi_spec_dirs = ["/var/cdi/static", "/var/cdi/dynamic"]
    device_ownership_from_security_context = true
---
# disableManifestsDirectory is dropped — always disabled in 1.14 multi-doc format
apiVersion: v1alpha1
kind: KubeletConfig
image: ghcr.io/siderolabs/kubelet:v1.36.3
defaultRuntimeSeccompProfileEnabled: true
extraConfig:
  serializeImagePulls: false
extraMounts:
  - destination: /var/lib/longhorn
    options:
      - bind
      - rshared
      - rw
    source: /var/lib/longhorn
    type: bind
---
# Base node config for all nodes — CP role label and per-node zone label are added by role/node overlays
apiVersion: v1alpha1
kind: KubeNodeConfig
annotations:
  tuppr.home-operations.com/schematic: "89c7d76eb7d8a185c8e80f7e5b6d3c78d8bc31f4f27c12fde293e13f5c4e035f"
labels:
  intel.feature.node.kubernetes.io/gpu: "true"
  topology.kubernetes.io/region: main
---
# VERIFY: ResolverConfig schema — confirm top-level field names (not nested under hostDNS)
apiVersion: v1alpha1
kind: ResolverConfig
enabled: true
forwardKubeDNSToHost: true
resolveMemberNames: true
---
apiVersion: v1alpha1
kind: KubePrismConfig
enabled: true
port: 7445
---
# cni: none is dropped — absence of KubeFlannelCNIConfig = no Flannel (Cilium manages networking)
apiVersion: v1alpha1
kind: KubeNetworkConfig
dnsDomain: cluster.local
podSubnets:
  - 10.244.0.0/16
serviceSubnets:
  - 10.96.0.0/12
---
# disabled: true → enabled: false in multi-doc format
apiVersion: v1alpha1
kind: KubeProxyConfig
enabled: false
image: registry.k8s.io/kube-proxy:v1.36.3
---
# New in 1.14 — not present in v1alpha1. 168h = weekly trim cycle.
apiVersion: v1alpha1
kind: FilesystemTrimConfig
enabled: true
interval: 168h
---
apiVersion: v1alpha1
kind: UserVolumeConfig
name: local-hostpath
provisioning:
  diskSelector:
    match: disk.transport == "sata"
  minSize: 512GB
