---
# STAGED DRAFT — targets Talos 1.14 multi-document config format
# CP-only overlay — patched on top of cluster.yaml.j2 for control-plane nodes.
#
# v1alpha1 block: CA private keys, serviceAccount key, etcd CA keys.
# These stay in v1alpha1 because the new CA document kinds take raw PEM; SOPS stores base64.
# The shim handles base64→PEM decoding only for v1alpha1 CA fields.
version: v1alpha1
machine:
  ca:
    # Repeat crt alongside key: strategic merge replaces the entire machine.ca object.
    # Without crt here, the merge would send only the key and clear the crt written by cluster.yaml.j2.
    crt: {{ ENV.MACHINE_CA_CRT }}
    key: {{ ENV.MACHINE_CA_KEY }}
  type: controlplane
cluster:
  ca:
    # Same crt-alongside-key requirement as machine.ca above.
    crt: {{ ENV.CLUSTER_CA_CRT }}
    key: {{ ENV.CLUSTER_CA_KEY }}
  aggregatorCA:
    crt: {{ ENV.CLUSTER_AGGREGATOR_CA_CRT }}
    key: {{ ENV.CLUSTER_AGGREGATOR_CA_KEY }}
  serviceAccount:
    key: {{ ENV.CLUSTER_SA_KEY }}
  etcd:
    ca:
      crt: {{ ENV.CLUSTER_ETCD_CA_CRT }}
      key: {{ ENV.CLUSTER_ETCD_CA_KEY }}
    extraArgs:
      listen-metrics-urls: http://0.0.0.0:2381
---
# machine.features.kubernetesTalosAPIAccess is deprecated in 1.14 in favor of
# this document kind — presence of the document implies enabled, no `enabled` field.
apiVersion: v1alpha1
kind: KubeTalosAPIAccessConfig
allowedRoles:
  - os:admin
allowedKubernetesNamespaces:
  - actions-runner-system
  - security
  - system-upgrade
---
apiVersion: v1alpha1
kind: KubeAPIServerConfig
image: registry.k8s.io/kube-apiserver:v1.37.0
certExtraSANs:
  - 127.0.0.1
  - 10.1.20.11
extraArgs:
  enable-aggregator-routing: "true"
  feature-gates: MutatingAdmissionPolicy=true
  runtime-config: admissionregistration.k8s.io/v1beta1=true
---
# PodSecurity admission moved to its own document kind in 1.14 —
# KubeAPIServerConfig no longer carries an admissionControl field at all.
apiVersion: v1alpha1
kind: KubeAdmissionControlConfig
name: PodSecurity
configuration:
  apiVersion: pod-security.admission.config.k8s.io/v1alpha1
  kind: PodSecurityConfiguration
  defaults:
    enforce: baseline
    enforce-version: latest
    audit: restricted
    audit-version: latest
    warn: restricted
    warn-version: latest
  exemptions:
    namespaces:
      - kube-system
    runtimeClasses: []
    usernames: []
---
apiVersion: v1alpha1
kind: KubeAuditPolicyConfig
configuration:
  apiVersion: audit.k8s.io/v1
  kind: Policy
  rules:
    - level: Metadata
---
# Explicit authorizers required: InjectDefaultAuthorizers() returns false with multi-doc format.
# Order is load-bearing: node must precede rbac.
apiVersion: v1alpha1
kind: KubeAuthorizerConfig
name: node
type: Node
---
apiVersion: v1alpha1
kind: KubeAuthorizerConfig
name: rbac
type: RBAC
---
apiVersion: v1alpha1
kind: KubeAuthenticationConfig
configuration:
  anonymous:
    conditions:
      - path: /livez
      - path: /readyz
      - path: /healthz
    enabled: true
  jwt: []
---
# key2 is hardcoded by the v1alpha1 shim (not key1). Must match for decryption to succeed on existing data.
apiVersion: v1alpha1
kind: KubeEtcdEncryptionConfig
config:
  resources:
    - resources:
        - secrets
      providers:
        - secretbox:
            keys:
              - name: key2
                secret: {{ ENV.CLUSTER_SECRETBOX_ENCRYPTION_SECRET }}
        - identity: {}
---
# apiVersion/kind stripped from embedded config — KubeSchedulerConfig establishes the type.
apiVersion: v1alpha1
kind: KubeSchedulerConfig
image: registry.k8s.io/kube-scheduler:v1.37.0
extraArgs:
  bind-address: 0.0.0.0
config:
  profiles:
    - schedulerName: default-scheduler
      plugins:
        score:
          disabled:
            - name: ImageLocality
      pluginConfig:
        - name: PodTopologySpread
          args:
            defaultingType: List
            defaultConstraints:
              - maxSkew: 1
                topologyKey: kubernetes.io/hostname
                whenUnsatisfiable: ScheduleAnyway
---
apiVersion: v1alpha1
kind: KubeControllerManagerConfig
image: registry.k8s.io/kube-controller-manager:v1.37.0
extraArgs:
  bind-address: 0.0.0.0
---
# KubeProxyConfig is control-plane-only (verified: pkg/machinery/config/container/validate.go
# rejects it on worker machines) — moved here from cluster.yaml.j2, which is rendered for
# every node including workers. disabled: true -> enabled: false in multi-doc format.
apiVersion: v1alpha1
kind: KubeProxyConfig
enabled: false
image: registry.k8s.io/kube-proxy:v1.37.0
---
# No taints = scheduling allowed on control plane (replaces allowSchedulingOnControlPlanes: true).
# Labels merge with the base KubeNodeConfig from cluster.yaml.j2.
apiVersion: v1alpha1
kind: KubeNodeConfig
labels:
  node-role.kubernetes.io/control-plane: ""
